{
  "principal": {{ quote .Subject.ID }}
  {{ if .Outputs.oidc_contextualizer.email -}},
  {{- if not .Outputs.oidc_contextualizer.email_verified -}}
  {{ fail "request denied: oidc_contextualizer returned unverified email" }}
  {{- end }}
  "email": {{ quote .Outputs.oidc_contextualizer.email }}
  {{ end -}}
  {{ if .Values.aud -}},
  "aud": {{ quote .Values.aud }}
  {{ end -}}
  {{ with .Subject.Attributes.sub -}},
  "user_id": {{ quote . }}
  {{ end -}}
}
